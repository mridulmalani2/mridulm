{
  "redirects": [
    {
      "source": "/research/toolkit",
      "destination": "/deal-engine",
      "permanent": true
    },
    {
      "source": "/research",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/research/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^(mridulm|mridulm-mriduls-projects-2c4774ae|mridulm-git-main-mriduls-projects-2c4774ae)\\.vercel\\.app$"
        }
      ],
      "destination": "https://www.mridulmalani.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
